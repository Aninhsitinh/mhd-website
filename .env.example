# ==============================================================================
# MHD Valuation - Environment Configuration Template
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env trên server / môi trường chạy thực tế:
#   cp .env.example .env
# Sau đó cập nhật các thông tin bảo mật bên dưới trước khi khởi chạy Docker.

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
# Nếu password có ký tự đặc biệt như @, hãy URL-encode (ví dụ @ thành %40)
POSTGRES_PASSWORD_ENCODED=your_strong_password_here
POSTGRES_DB=mhd_cms
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Payload CMS 3.0 Configuration
# ------------------------------------------------------------------------------
# Chuỗi secret dùng để mã hóa session và token JWT của Payload CMS (tạo bằng: openssl rand -hex 32)
PAYLOAD_SECRET=your_generated_payload_secret_min_32_characters

# URL công khai của CMS server (dùng cho CORS và link media)
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 3. Nuxt 3 Frontend Configuration
# ------------------------------------------------------------------------------
# URL API của Payload CMS mà Frontend sẽ gọi tới
PAYLOAD_API_URL=http://localhost:3001/api
PAYLOAD_SERVER_URL=http://cms:3001/api
NUXT_PUBLIC_PAYLOAD_API_URL=http://localhost:3001/api

# Google Gemini API Key (phục vụ AI Chatbot hỗ trợ báo giá và tư vấn thẩm định)
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. System & Server
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
